{# /weekly Phase 2 dashboard — task-centric (지난주/이번주 + 그룹별).

   Constraints inherited from v1:
   - no CDN, all CSS inline (email-safe)
   - autoescape ON (FIX-01) — every {{ x }} escapes by default
   - Korean-first, print-friendly, WCAG AA
   - warm gray bg + deep teal accent (CLAUDE.md tokens)
#}
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ team_name }} 주간보고 — {{ week }}</title>
<style>
  :root {
    --bg: #F5F3F0;
    --surface: #FFFFFF;
    --primary: #1B6B5A;
    --primary-soft: #E6F0EE;
    --text: #1F2937;
    --muted: #6B7280;
    --border: #E5E7EB;
    --warn: #D97706;
    --warn-bg: #FEF3C7;
    --danger: #B91C1C;
    --danger-bg: #FEE2E2;
    --ok: #047857;
    --ok-bg: #D1FAE5;
    --radius: 8px;
    --shadow: 0 1px 3px rgba(15, 23, 42, 0.06);
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { font-size: 16px; }
  body {
    margin: 0;
    font-family: "Pretendard", -apple-system, BlinkMacSystemFont, "Segoe UI",
                 "Apple SD Gothic Neo", "Malgun Gothic", "Helvetica Neue", sans-serif;
    line-height: 1.6;
    color: var(--text);
    background: var(--bg);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  main { max-width: 920px; margin: 0 auto; padding: 2rem 1.25rem 4rem; }

  header.report-header {
    border-bottom: 2px solid var(--primary);
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
  }
  header.report-header .eyebrow {
    color: var(--muted); font-size: 0.85rem;
    letter-spacing: 0.05em; text-transform: uppercase;
    margin: 0 0 0.25rem;
  }
  header.report-header h1 {
    color: var(--primary); font-size: 1.75rem;
    margin: 0; font-weight: 700; line-height: 1.3;
  }

  section { margin-top: 2rem; }
  section > h2 {
    color: var(--primary); font-size: 1.25rem;
    margin: 0 0 0.75rem; font-weight: 600;
  }
  section > h3 {
    font-size: 1.05rem; margin: 1.5rem 0 0.5rem;
    color: var(--text); font-weight: 600;
  }

  .summary {
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 4px solid var(--primary);
    padding: 1rem 1.25rem;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .summary strong { color: var(--primary); display: block; margin-bottom: 0.5rem; }

  .group-header {
    display: flex; align-items: baseline; gap: 0.75rem;
    margin: 1.75rem 0 0.5rem;
    padding-bottom: 0.25rem;
    border-bottom: 1px dashed var(--border);
  }
  .group-header .group-name { font-size: 1.05rem; font-weight: 600; color: var(--primary); }
  .group-header .group-summary { color: var(--muted); font-size: 0.95rem; }

  .badge {
    display: inline-block; padding: 0.1rem 0.5rem;
    border-radius: 999px; font-size: 0.78rem; font-weight: 600;
  }
  .badge-status-정상 { background: var(--ok-bg); color: var(--ok); }
  .badge-status-주의 { background: var(--warn-bg); color: var(--warn); }
  .badge-status-위험 { background: var(--danger-bg); color: var(--danger); }
  .badge-state-진행중 { background: var(--primary-soft); color: var(--primary); }
  .badge-state-지연 { background: var(--warn-bg); color: var(--warn); }
  .badge-state-보류 { background: var(--warn-bg); color: var(--warn); }
  .badge-state-미착수 { background: #F3F4F6; color: var(--muted); }
  .badge-state-완료 { background: var(--ok-bg); color: var(--ok); }
  .badge-state-취소 { background: #F3F4F6; color: var(--muted); }
  .badge-pri-높음 { background: var(--danger-bg); color: var(--danger); }
  .badge-pri-보통 { background: #F3F4F6; color: var(--muted); }
  .badge-pri-낮음 { background: #F3F4F6; color: var(--muted); }

  .task {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.75rem 1rem;
    margin: 0.5rem 0;
    box-shadow: var(--shadow);
  }
  .task .task-head {
    display: flex; flex-wrap: wrap;
    align-items: baseline; gap: 0.5rem;
    margin-bottom: 0.4rem;
  }
  .task .task-id {
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Consolas, monospace;
    color: var(--muted); font-size: 0.85rem;
  }
  .task .task-part { color: var(--muted); font-size: 0.85rem; }
  .task .task-title { font-weight: 600; }
  .task .task-meta { color: var(--muted); font-size: 0.85rem; margin-top: 0.4rem; }
  .task dl { margin: 0.4rem 0 0; padding: 0; }
  .task dt {
    color: var(--muted); font-size: 0.78rem; text-transform: uppercase;
    letter-spacing: 0.04em; margin-top: 0.5rem;
  }
  .task dd { margin: 0; padding: 0; }
  .task ul { margin: 0; padding-left: 1.1rem; }
  .task li { margin-bottom: 0.15rem; }

  .empty { color: var(--muted); font-style: italic; padding: 0.5rem 0; }

  .lead-attention {
    background: var(--warn-bg);
    border-left: 4px solid var(--warn);
    border-radius: var(--radius);
    padding: 0.75rem 1rem;
    margin-top: 0.75rem;
  }
  .lead-attention li { color: #92400E; margin-bottom: 0.4rem; }

  .missing-notice {
    color: var(--danger); font-weight: 600;
    background: var(--danger-bg);
    border-left: 4px solid var(--danger);
    padding: 0.75rem 1rem; border-radius: var(--radius);
    margin-top: 0.75rem;
  }
  .warnings {
    background: var(--warn-bg);
    border-left: 4px solid var(--warn);
    padding: 0.75rem 1rem 0.75rem 2rem;
    border-radius: var(--radius);
    margin-top: 0.5rem;
  }
  .warnings li { color: #92400E; }

  footer.report-footer {
    color: var(--muted); font-size: 0.8rem;
    margin-top: 4rem; padding-top: 1rem;
    border-top: 1px solid var(--border);
    text-align: center;
  }

  @media (max-width: 480px) {
    main { padding: 1rem 0.75rem 2rem; }
    header.report-header h1 { font-size: 1.4rem; }
    section > h2 { font-size: 1.1rem; }
  }
  @media print {
    body { background: #fff; }
    main { padding: 0; max-width: 100%; }
    .summary, .task, .lead-attention, .missing-notice, .warnings { box-shadow: none; }
    section, .task { break-inside: avoid; }
    footer.report-footer { display: none; }
  }
</style>
</head>
<body>
<main>
  <header class="report-header">
    <p class="eyebrow">주간보고</p>
    <h1>{{ team_name }} — {{ week }}</h1>
  </header>

  {% macro render_task(item) -%}
    <article class="task">
      <div class="task-head">
        <span class="task-id">{{ item.업무ID }}</span>
        {% if item.상태 -%}
          <span class="badge badge-state-{{ item.상태 }}">{{ item.상태 }}</span>
        {%- endif %}
        {% if item.우선순위 -%}
          <span class="badge badge-pri-{{ item.우선순위 }}">{{ item.우선순위 }}</span>
        {%- endif %}
        <span class="task-part">{{ item.그룹 }} / {{ item.파트 }}</span>
      </div>
      <div class="task-title">{{ item.업무 }}</div>
      {% if item.이번주_처리결과 %}
        <dl><dt>이번주 처리결과</dt>
          <dd><ul>{% for x in item.이번주_처리결과 %}<li>{{ x }}</li>{% endfor %}</ul></dd>
        </dl>
      {% endif %}
      {% if item.이슈 %}
        <dl><dt>이슈</dt>
          <dd><ul>{% for x in item.이슈 %}<li>{{ x }}</li>{% endfor %}</ul></dd>
        </dl>
      {% endif %}
      {% if item.리스크_지원요청 %}
        <dl><dt>리스크 / 지원요청</dt>
          <dd><ul>{% for x in item.리스크_지원요청 %}<li>{{ x }}</li>{% endfor %}</ul></dd>
        </dl>
      {% endif %}
      {% if item.다음액션 %}
        <dl><dt>다음 액션</dt>
          <dd><ul>{% for x in item.다음액션 %}<li>{{ x }}</li>{% endfor %}</ul></dd>
        </dl>
      {% endif %}
      <div class="task-meta">
        {% if item.마감 %}마감 {{ item.마감 }}{% endif %}
      </div>
    </article>
  {%- endmacro %}

  <section aria-labelledby="summary-heading">
    <h2 id="summary-heading">종합 요약</h2>
    <div class="summary">
      <strong>이번 주 핵심</strong>
      {{ result.팀_종합_요약 | nl2br }}
    </div>
  </section>

  {% if result.그룹별_요약 %}
  <section aria-labelledby="groups-heading">
    <h2 id="groups-heading">그룹별 상태</h2>
    {% for gname, gdata in result.그룹별_요약.items() %}
      <div class="group-header">
        <span class="group-name">{{ gname }}</span>
        {% if gdata.상태 -%}
          <span class="badge badge-status-{{ gdata.상태 }}">{{ gdata.상태 }}</span>
        {%- endif %}
        <span class="group-summary">{{ gdata.요약 }}</span>
      </div>
    {% endfor %}
  </section>
  {% endif %}

  <section aria-labelledby="last-week-heading">
    <h2 id="last-week-heading">지난주 미결 처리현황</h2>
    {% if result.지난주.요약 %}
      <p>{{ result.지난주.요약 }}</p>
    {% endif %}
    {% if result.지난주.항목 %}
      {% for item in result.지난주.항목 %}{{ render_task(item) }}{% endfor %}
    {% else %}
      <p class="empty">지난주에서 넘어온 미결 항목이 없습니다.</p>
    {% endif %}
  </section>

  <section aria-labelledby="this-week-heading">
    <h2 id="this-week-heading">이번주 신규/진행 현황</h2>
    {% if result.이번주.요약 %}
      <p>{{ result.이번주.요약 }}</p>
    {% endif %}
    {% if result.이번주.항목 %}
      {% for item in result.이번주.항목 %}{{ render_task(item) }}{% endfor %}
    {% else %}
      <p class="empty">이번주 신규/진행 항목이 없습니다.</p>
    {% endif %}
  </section>

  {% if result.그룹장_확인필요 %}
  <section aria-labelledby="lead-attention-heading">
    <h2 id="lead-attention-heading">그룹장 확인 필요</h2>
    <ul class="lead-attention">
      {% for x in result.그룹장_확인필요 %}
        <li>
          <strong>[{{ x.그룹 }} / {{ x.파트 }}]</strong>
          {% if x.업무ID %}<span class="task-id">{{ x.업무ID }}</span>{% endif %}
          {{ x.내용 }}
          {% if x.희망기한 %}<span class="task-meta">(희망기한 {{ x.희망기한 }})</span>{% endif %}
        </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if result.미작성_파트 %}
  <section aria-labelledby="missing-heading">
    <h2 id="missing-heading">미작성 파트</h2>
    <p class="missing-notice" role="alert">미작성: {{ result.미작성_파트 | join(", ") }}</p>
    {% if result.미응답_배정항목 %}
    <p class="missing-subnotice">
      아래 업무는 자동 배정되었지만 파트장이 아직 응답하지 않았습니다.
    </p>
    <ul class="unanswered-list">
      {% for x in result.미응답_배정항목 %}
        <li>
          {% if x.업무ID %}<span class="task-id">{{ x.업무ID }}</span>{% endif %}
          <span class="part-tag">{{ x.파트 }}</span>
          {{ x.업무 }}
          {% if x.마감 %}<span class="task-meta">(마감 {{ x.마감 }})</span>{% endif %}
          {% if x.우선순위 %}<span class="task-meta">[{{ x.우선순위 }}]</span>{% endif %}
        </li>
      {% endfor %}
    </ul>
    {% endif %}
  </section>
  {% endif %}

  {% if result.주의사항 %}
  <section aria-labelledby="warnings-heading">
    <h2 id="warnings-heading">주의사항</h2>
    <ul class="warnings">{% for x in result.주의사항 %}<li>{{ x }}</li>{% endfor %}</ul>
  </section>
  {% endif %}

  <footer class="report-footer">
    생성: {{ generated_at }} · /weekly v{{ weekly_version }}
  </footer>
</main>
</body>
</html>
