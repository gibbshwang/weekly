team:
  name: "{{ team_name }}"
  lead:
    name: "{{ team_lead_name }}"
    email: "{{ team_lead_email }}"
  groups:
{% for g in groups %}    - name: "{{ g.name }}"
      lead:
        name: "{{ g.lead_name }}"
        email: "{{ g.lead_email }}"
      parts:
{% for p in g.parts %}        - name: "{{ p.name }}"
          lead:
            name: "{{ p.lead_name }}"
            email: "{{ p.lead_email }}"
{% if p.role %}          role: {{ p.role | tojson }}
{% endif %}{% endfor %}{% endfor %}
storage:
  type: "{{ storage_type }}"
  root: {{ storage_root | tojson }}
schedule:
  prepare_cron: "{{ prepare_cron | default('0 6 * * 1') }}"
  assign_cron: "{{ assign_cron | default('0 * * * *') }}"
  compile_cron: "{{ compile_cron | default('0 17 * * 5') }}"
  timezone: "{{ timezone | default('Asia/Seoul') }}"
smtp:
  host: "{{ smtp_host }}"
  port: {{ smtp_port }}
  use_tls: {{ smtp_use_tls | lower }}
  user: "{{ smtp_user }}"
ai:
  provider: "{{ ai_provider }}"
prompts:
  override_dir: null
