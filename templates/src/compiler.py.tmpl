"""Compile stage — read each part's xlsx, call LLM, return structured result.

The LLM is invoked via subprocess (Codex CLI or Gemini CLI). The system
prompt enforces JSON output. We tolerate occasional markdown code-fence
wrapping and strip it before json.loads.

Phase 2 task-centric pipeline:
- collect_parts(week_dir, team)              — reads xlsx 지난주 + 이번주 sheets
- run_compile(llm, team, week, parts_data, prompt_template_path)
                                             — feeds the LLM the new schema
                                               (지난주 / 이번주 항목 arrays
                                                + 그룹별_요약 + 그룹장_확인필요)
"""
import json
import re
from datetime import date, timedelta
from pathlib import Path
from typing import Any, Dict, List, Tuple

from jinja2 import Template


_ISO_WEEK_RE = re.compile(r"^(\d{4})-W(\d{1,2})$")


def _week_date_ranges(week: str) -> Dict[str, str]:
    """Return Mon–Sun ISO date strings for the given ISO week and the next.

    Input format is `YYYY-Www` (e.g. `2026-W18`). Output keys:
    `this_week_start`, `this_week_end`, `next_week_start`, `next_week_end`.

    Used by `run_compile` to inject deterministic dates into the prompt so
    the LLM doesn't have to compute "이번 주" / "다음 주" itself — that path
    fails when the model's training cutoff predates the report week.
    """
    m = _ISO_WEEK_RE.fullmatch(week.strip())
    if not m:
        raise ValueError(
            f"Invalid ISO week format {week!r}; expected 'YYYY-Www' (e.g. '2026-W18')"
        )
    year, wk = int(m.group(1)), int(m.group(2))
    this_mon = date.fromisocalendar(year, wk, 1)
    this_sun = date.fromisocalendar(year, wk, 7)
    next_mon = this_mon + timedelta(days=7)
    next_sun = this_sun + timedelta(days=7)
    return {
        "this_week_start": this_mon.isoformat(),
        "this_week_end": this_sun.isoformat(),
        "next_week_start": next_mon.isoformat(),
        "next_week_end": next_sun.isoformat(),
    }

try:
    from openpyxl import load_workbook
    from weekly_runtime.xlsx_template import PART_SHEET_HEADERS
except ImportError:  # pragma: no cover — exercised by harness tests
    from openpyxl import load_workbook
    from scripts.xlsx_template import PART_SHEET_HEADERS


def _strip_code_fence(text: str) -> str:
    """Remove ```json ... ``` wrapping if present."""
    text = text.strip()
    if text.startswith("```"):
        text = text.split("```", 2)[1]
        if text.lstrip().startswith("json"):
            text = text.lstrip()[4:]
        text = text.rsplit("```", 1)[0]
    return text.strip()


def _read_part_workbook(part_xlsx_path: Path) -> Tuple[List[Dict[str, Any]], List[Dict[str, Any]]]:
    """Return (이번주_rows, 지난주_rows) as lists of header→value dicts.

    A row is "data" if its 업무ID column is non-empty (matches the
    convention used by prepare/assigner). 지난주_완료 is intentionally
    NOT read — completed items are out of scope for this week's compile.
    """
    wb = load_workbook(part_xlsx_path)
    out: Dict[str, List[Dict[str, Any]]] = {"이번주": [], "지난주": []}
    for sheet_name in ("이번주", "지난주"):
        if sheet_name not in wb.sheetnames:
            continue
        for raw in wb[sheet_name].iter_rows(min_row=2, values_only=True):
            if not raw or not raw[0]:
                continue
            row: Dict[str, Any] = {}
            for i, h in enumerate(PART_SHEET_HEADERS):
                v = raw[i] if i < len(raw) else None
                row[h] = "" if v is None else str(v)
            out[sheet_name].append(row)
    return out["이번주"], out["지난주"]


# Columns the part lead is responsible for filling in. assign auto-creates
# rows with 업무ID + 출처 + 업무_지시내용 + 마감 + 우선순위 + 비고 populated
# (비고 is copied from _지시사항.xlsx — instructor's note, NOT lead input).
# 미작성 means "the lead has not touched any column they own", which is
# the part-status columns below — 비고 is excluded so an instructor-supplied
# note does not flip the part to 'written' before the lead opens the file.
USER_INPUT_HEADERS = (
    "상태",
    "이번주_처리결과",
    "이슈_장애",
    "리스크_지원요청",
    "다음액션_차주계획",
)


def _row_has_user_input(row: Dict[str, Any]) -> bool:
    return any((row.get(h) or "").strip() for h in USER_INPUT_HEADERS)


def collect_parts(week_dir: Path, team) -> Dict[str, Dict[str, Any]]:
    """For each (group, part) in `team`, read its xlsx and return:

      {part_name: {"group": <group_name>,
                   "이번주": [row_dict, ...],
                   "지난주": [row_dict, ...],
                   "미작성": bool}}

    A part is 미작성 when its workbook is missing OR no row in either sheet
    has any user-input column populated. Auto-assigned rows that the lead
    hasn't touched do NOT flip 미작성 to False.
    """
    week_dir = Path(week_dir)
    out: Dict[str, Dict[str, Any]] = {}
    for group, part in team.iter_parts():
        path = week_dir / f"{part.name}.xlsx"
        if not path.exists():
            out[part.name] = {
                "group": group.name, "미작성": True,
                "이번주": [], "지난주": [],
            }
            continue
        this_week_rows, last_week_rows = _read_part_workbook(path)
        any_input = any(
            _row_has_user_input(r)
            for r in (*this_week_rows, *last_week_rows)
        )
        out[part.name] = {
            "group": group.name,
            "이번주": this_week_rows,
            "지난주": last_week_rows,
            "미작성": not any_input,
        }
    return out


def _format_row_for_llm(row: Dict[str, Any]) -> str:
    """Pretty-print one task row for the user prompt."""
    bullets = []
    for k in ("이번주_처리결과", "이슈_장애", "리스크_지원요청", "다음액션_차주계획"):
        if row.get(k):
            bullets.append(f"  {k.replace('_', '/')}: {row[k]}")
    head = (
        f"- {row.get('업무ID', '')} "
        f"[{row.get('상태', '') or '미입력'}] "
        f"({row.get('출처', '') or '-'}) "
        f"{row.get('업무_지시내용', '')}"
    )
    tail = (
        f"  마감: {row.get('마감', '') or '-'} | "
        f"우선순위: {row.get('우선순위', '') or '-'}"
    )
    return "\n".join([head, *bullets, tail])


def _build_user_prompt(team_name: str, week: str, parts_data: Dict[str, Dict[str, Any]]) -> str:
    """Render the structured Korean text payload the prompt expects."""
    lines = [f"## 팀: {team_name} | 주차: {week}", ""]
    # Group parts by their .group field so the model sees the org structure.
    by_group: Dict[str, List[Tuple[str, Dict[str, Any]]]] = {}
    for part_name, data in parts_data.items():
        by_group.setdefault(data.get("group", "(미지정)"), []).append((part_name, data))

    for group_name, parts in by_group.items():
        lines.append(f"### 그룹: {group_name}")
        for part_name, data in parts:
            lines.append(f"파트: {part_name}")
            if data.get("미작성"):
                lines.append("(미작성)")
                lines.append("")
                continue
            lines.append("[지난주]")
            if data["지난주"]:
                for r in data["지난주"]:
                    lines.append(_format_row_for_llm(r))
            else:
                lines.append("(없음)")
            lines.append("[이번주]")
            if data["이번주"]:
                for r in data["이번주"]:
                    lines.append(_format_row_for_llm(r))
            else:
                lines.append("(없음)")
            lines.append("")
    return "\n".join(lines)


def run_compile(
    llm,
    team,
    week: str,
    parts_data: Dict[str, Dict[str, Any]],
    prompt_template_path: Path,
) -> Dict[str, Any]:
    """Run a compile pass. Returns parsed JSON dict matching the v2 schema."""
    groups_for_prompt = [
        {"name": g.name, "parts": [p.name for p in g.parts]}
        for g in team.groups
    ]
    date_ranges = _week_date_ranges(week)
    sys_prompt = Template(Path(prompt_template_path).read_text(encoding="utf-8")).render(
        team_name=team.name,
        groups=groups_for_prompt,
        week=week,
        **date_ranges,
    )
    user_prompt = _build_user_prompt(team.name, week, parts_data)
    raw = llm.call(sys_prompt, user_prompt)
    return json.loads(_strip_code_fence(raw))
