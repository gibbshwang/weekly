"""Cross-platform scheduler primitives for /weekly cron tasks.

Windows: `schtasks.exe` (Task Scheduler)
Unix: `crontab` (POSIX cron)

Cron strings follow standard 5-field syntax. On Windows we translate to
`/SC` flags via a small heuristic; complex cron strings fall back to
`/SC HOURLY` (with a default behavior the operator can correct via
schtasks GUI if needed).

Security: every install_task input is validated before reaching the
shell-bearing surfaces (`schtasks /TR`, `crontab -`). Hostile values
in cron / working_dir / command / name would otherwise become RCE
on the host that runs the schedule (potentially with elevated rights
under Task Scheduler).
"""
import re
import shlex
import subprocess
import sys
from typing import List


_MARKER_PREFIX = "# weekly-managed:"

# Each cron field allows digits, *, /, comma, hyphen. A semicolon, backtick,
# or `$(...)` in the cron string would be reinterpreted by the shell at run
# time — reject before they reach the crontab.
_CRON_FIELD_RE = re.compile(r"^[\d*/,\-]+$")

# Task names land directly in `/TN` (Windows) and as the marker label (Unix).
# Restrict to the same slug shape used elsewhere in the project.
_TASK_NAME_RE = re.compile(r"^[가-힣A-Za-z0-9_-]{1,80}$")

# Characters forbidden inside working_dir / command. Newlines could synthesize
# a new crontab line; NUL/CR truncate the line at the wrong point; quote
# escapes the schtasks /TR string; `%` is special in crontab (it splits the
# command from stdin) so it would re-interpret the rest of the command.
_FORBIDDEN_CHARS = set("\"\r\n\x00%")


def _validate_cron(cron: str) -> str:
    if not isinstance(cron, str):
        raise ValueError(f"cron must be a string, got {type(cron).__name__}")
    # Reject CR/LF/NUL up front — they would smuggle a new crontab line
    # past the 5-field split() check.
    if any(c in cron for c in "\r\n\x00"):
        raise ValueError(f"cron must not contain newline or NUL characters: {cron!r}")
    parts = cron.strip().split()
    if len(parts) != 5:
        raise ValueError(
            f"cron must have 5 whitespace-separated fields, got {len(parts)}: {cron!r}"
        )
    for p in parts:
        if not _CRON_FIELD_RE.fullmatch(p):
            raise ValueError(
                f"cron field {p!r} contains characters outside [0-9 * / , -]; "
                f"shell metacharacters and whitespace are not allowed inside a field"
            )
    return cron.strip()


def _validate_task_name(name: str) -> str:
    if not isinstance(name, str) or not _TASK_NAME_RE.fullmatch(name):
        raise ValueError(
            f"task name must be 1-80 chars of Korean / A-Z / 0-9 / _ / -, got: {name!r}"
        )
    return name


def _validate_no_forbidden(value: str, label: str) -> str:
    if not isinstance(value, str):
        raise ValueError(f"{label} must be a string, got {type(value).__name__}")
    bad = sorted({c for c in value if c in _FORBIDDEN_CHARS})
    if bad:
        raise ValueError(
            f"{label} contains forbidden characters {bad!r}: {value!r}"
        )
    return value


def install_task(name: str, cron: str, command: str, working_dir: str) -> None:
    """Register a scheduled task. Idempotent (uninstall then install)."""
    name = _validate_task_name(name)
    cron = _validate_cron(cron)
    command = _validate_no_forbidden(command, "command")
    working_dir = _validate_no_forbidden(working_dir, "working_dir")
    if sys.platform == "win32":
        _install_windows(name, cron, command, working_dir)
    else:
        _install_unix(name, cron, command, working_dir)


def uninstall_task(name: str) -> None:
    """Remove the named task. No error if the task does not exist."""
    if sys.platform == "win32":
        _uninstall_windows(name)
    else:
        _uninstall_unix(name)


def list_tasks(prefix: str = "weekly-") -> List[str]:
    if sys.platform == "win32":
        return _list_windows(prefix)
    return _list_unix(prefix)


# --- Windows (schtasks) ---

def _windows_schedule_flags(cron: str) -> List[str]:
    cron = cron.strip()
    if cron == "0 * * * *":
        return ["/SC", "HOURLY"]
    m = re.fullmatch(r"(\d+) (\d+) \* \* (\d)", cron)
    if m:
        minute, hour, dow = m.groups()
        days = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"]
        return ["/SC", "WEEKLY", "/D", days[int(dow)],
                "/ST", f"{int(hour):02d}:{int(minute):02d}"]
    return ["/SC", "HOURLY"]


def _install_windows(name: str, cron: str, command: str, working_dir: str) -> None:
    cmd = [
        "schtasks", "/Create", "/TN", name, "/F",
        "/TR", f'cmd /c cd /d "{working_dir}" && {command}',
    ]
    cmd += _windows_schedule_flags(cron)
    res = subprocess.run(cmd, capture_output=True, text=True, encoding="utf-8")
    if res.returncode != 0:
        raise RuntimeError(f"schtasks /Create failed: {res.stderr}")


def _uninstall_windows(name: str) -> None:
    # Note: /Delete on a non-existent task returns nonzero, but from the
    # caller's perspective "task is gone" is the desired postcondition,
    # so we intentionally do not raise on failure.
    subprocess.run(
        ["schtasks", "/Delete", "/TN", name, "/F"],
        capture_output=True, text=True, encoding="utf-8",
    )


def _list_windows(prefix: str) -> List[str]:
    res = subprocess.run(
        ["schtasks", "/Query", "/FO", "CSV"],
        capture_output=True, text=True, encoding="utf-8",
    )
    out = []
    for line in res.stdout.splitlines()[1:]:
        if not line.startswith('"'):
            continue
        name = line.split('"')[1].lstrip("\\")
        if name.startswith(prefix):
            out.append(name)
    return out


# --- Unix (cron) ---

def _read_crontab() -> str:
    res = subprocess.run(["crontab", "-l"], capture_output=True, text=True)
    return res.stdout if res.returncode == 0 else ""


def _strip_managed_entry(crontab: str, name: str) -> List[str]:
    """Return crontab lines with the named entry (and its cron line) removed."""
    out = []
    skip_next = False
    marker = f"{_MARKER_PREFIX} {name}"
    for line in crontab.splitlines():
        if skip_next:
            skip_next = False
            continue
        if line.strip() == marker:
            skip_next = True
            continue
        out.append(line)
    return out


def _write_crontab(content: str) -> None:
    res = subprocess.run(
        ["crontab", "-"], input=content, text=True, capture_output=True
    )
    if res.returncode != 0:
        raise RuntimeError(
            f"crontab write failed (exit {res.returncode}): {res.stderr.strip()}"
        )


def _install_unix(name: str, cron: str, command: str, working_dir: str) -> None:
    existing = _read_crontab()
    cleaned = _strip_managed_entry(existing, name)
    cleaned.append(f"{_MARKER_PREFIX} {name}")
    # shlex.quote() wraps working_dir so cron's shell sees it as a single
    # argument even if it contains spaces. command is left unquoted because
    # it is intentionally a shell command (caller may chain with &&); the
    # forbidden-char validator above already rejected the dangerous shapes.
    cleaned.append(f"{cron} cd {shlex.quote(working_dir)} && {command}")
    _write_crontab("\n".join(cleaned) + "\n")


def _uninstall_unix(name: str) -> None:
    existing = _read_crontab()
    cleaned = _strip_managed_entry(existing, name)
    _write_crontab("\n".join(cleaned) + "\n")


def _list_unix(prefix: str) -> List[str]:
    out = []
    for line in _read_crontab().splitlines():
        if line.startswith(_MARKER_PREFIX):
            name = line.split(_MARKER_PREFIX, 1)[1].strip()
            if name.startswith(prefix):
                out.append(name)
    return out
