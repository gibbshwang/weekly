"""Pydantic config models for weekly_runtime.

Loaded from `config.yaml` at the project root (the directory `wreport` is invoked from).

Phase 2 (2026-04-26): Team → Group → Part hierarchy is the only supported form.
Legacy Department / PartLead were removed in the Wave E cleanup.
"""
import re
from pathlib import Path
from typing import Iterator, List, Literal, Optional, Tuple
import yaml
from pydantic import BaseModel, Field, field_validator


# Team / group / part names land in three sensitive places:
#   1. filesystem path joins (storage root, .xlsx filenames, dashboard output)
#   2. cron command interpolation (wreport prepare/assign/compile <name>)
#   3. Excel DataValidation list source
# Restrict to a slug-friendly charset that's safe for all three. Korean,
# alphanumeric, underscore, hyphen — nothing that needs shell, path, or
# spreadsheet escaping. The first character must NOT be `-` (Excel reads any
# cell starting with `=+@-` as a formula).
_SAFE_NAME_RE = re.compile(r"^[가-힣A-Za-z0-9_][가-힣A-Za-z0-9_-]{0,39}$")


def _validate_safe_name(value: str, label: str) -> str:
    if not isinstance(value, str) or not _SAFE_NAME_RE.fullmatch(value):
        raise ValueError(
            f"{label!r} must be 1-40 chars of Korean / A-Z / 0-9 / _ / - "
            f"(no spaces, no path separators, no Excel formula chars). "
            f"Got: {value!r}"
        )
    return value


class Person(BaseModel):
    name: str
    email: str  # plain str — allow non-RFC compliant test addresses


class Part(BaseModel):
    name: str
    lead: Person

    @field_validator("name")
    @classmethod
    def _check_name(cls, v: str) -> str:
        return _validate_safe_name(v, "team.groups[].parts[].name")


class Group(BaseModel):
    name: str
    lead: Person
    parts: List[Part]

    @field_validator("name")
    @classmethod
    def _check_name(cls, v: str) -> str:
        return _validate_safe_name(v, "team.groups[].name")

    @field_validator("parts")
    @classmethod
    def _check_parts(cls, v: List[Part]) -> List[Part]:
        if not v:
            raise ValueError("team.groups[].parts must not be empty")
        return v


class Team(BaseModel):
    name: str
    lead: Person
    groups: List[Group]

    @field_validator("name")
    @classmethod
    def _check_name(cls, v: str) -> str:
        return _validate_safe_name(v, "team.name")

    @field_validator("groups")
    @classmethod
    def _check_groups(cls, v: List[Group]) -> List[Group]:
        if not v:
            raise ValueError("team.groups must not be empty")
        # Part names participate in filesystem paths and 업무ID suffixes; if two
        # different groups both have a part named e.g. "전략기획" they would
        # collide on `<week>/전략기획.xlsx`. Reject at config load.
        seen = set()
        for g in v:
            for p in g.parts:
                if p.name in seen:
                    raise ValueError(
                        f"part name {p.name!r} appears in more than one group; "
                        f"part names must be unique within a team"
                    )
                seen.add(p.name)
        return v

    def iter_parts(self) -> Iterator[Tuple[Group, Part]]:
        """Yield (group, part) pairs in declaration order — used by consumers
        that operate on every part regardless of group membership."""
        for g in self.groups:
            for p in g.parts:
                yield g, p

    def all_part_lead_emails(self) -> List[str]:
        return [p.lead.email for _, p in self.iter_parts()]

    def all_group_lead_emails(self) -> List[str]:
        return [g.lead.email for g in self.groups]


class StorageConfig(BaseModel):
    type: Literal["local", "smb"]
    root: str  # path string (Windows or Unix), or UNC


class ScheduleConfig(BaseModel):
    assign_cron: str
    compile_cron: str
    # prepare runs Monday morning to set up the new week's part workbooks
    # (and carry-forward incomplete items from the prior week).
    # Default = every Monday at 06:00.
    prepare_cron: str = "0 6 * * 1"
    timezone: str = "Asia/Seoul"


class SMTPConfig(BaseModel):
    host: str
    port: int
    use_tls: bool = True
    user: str
    # password loaded from OS keyring (not in yaml)


class AIConfig(BaseModel):
    provider: Literal["codex", "gemini"] = "codex"
    model_assign: Optional[str] = None
    model_compile: Optional[str] = None


class PromptsConfig(BaseModel):
    override_dir: Optional[str] = None


class WeeklyConfig(BaseModel):
    team: Team
    storage: StorageConfig
    schedule: ScheduleConfig
    smtp: SMTPConfig
    ai: AIConfig
    prompts: PromptsConfig = Field(default_factory=PromptsConfig)


def load_config(path: Path) -> WeeklyConfig:
    """Load and validate config.yaml."""
    data = yaml.safe_load(Path(path).read_text(encoding="utf-8"))
    return WeeklyConfig.model_validate(data)
