"""Status command — report each part's writing progress.

Used by `wreport status`. Phase 2 reads the per-part xlsx workbook
(이번주 + 지난주 sheets) instead of the pre-Phase-2 .md per-part files.
"""
from datetime import datetime
from pathlib import Path
from typing import Any, Dict, List

try:
    from openpyxl import load_workbook
except ImportError:  # pragma: no cover
    load_workbook = None  # type: ignore


_MARKERS = {"written": "✓", "empty": "○", "missing": "✗"}


_USER_INPUT_COLS = (
    "상태",
    "이번주_처리결과",
    "이슈_장애",
    "리스크_지원요청",
    "다음액션_차주계획",
    "비고",
)
# These need to match the ordering in xlsx_template.PART_SHEET_HEADERS
# (kept inline here so this template doesn't have to import xlsx_template).
_PART_HEADERS = (
    "업무ID", "출처", "업무_지시내용", "상태",
    "이번주_처리결과", "이슈_장애", "리스크_지원요청",
    "다음액션_차주계획", "마감", "우선순위", "비고",
)


def _count_rows_with_user_input(xlsx_path: Path) -> int:
    """Count rows the part lead has actually touched (any user-input col filled).

    Auto-assigned rows that have only 업무ID + 출처 + 마감 etc. but nothing
    in the lead's columns do NOT count — otherwise `assign` would flip the
    status to "written" before the lead opened the file.
    """
    wb = load_workbook(xlsx_path)
    user_idx = [_PART_HEADERS.index(h) for h in _USER_INPUT_COLS]
    rows = 0
    for sheet_name in ("이번주", "지난주"):
        if sheet_name not in wb.sheetnames:
            continue
        for r in wb[sheet_name].iter_rows(min_row=2, values_only=True):
            if not r:
                continue
            if any((r[i] if i < len(r) else None) and str(r[i]).strip() for i in user_idx):
                rows += 1
    return rows


def compute_status(week_dir: Path, parts: List[str]) -> List[Dict[str, Any]]:
    """Return per-part status records.

    For each part:
      - status: "written" (any user-input row) | "empty" (xlsx exists but lead hasn't touched it) | "missing"
      - rows:   number of rows with at least one user-input column populated
      - mtime:  ISO 8601 string or None

    Args:
        week_dir: Directory holding the per-part workbooks (`<week>/<part>.xlsx`).
        parts:    Part names to inspect (e.g. ["전략기획", "사업개발"]).
    """
    week_dir = Path(week_dir)
    out: List[Dict[str, Any]] = []
    for part in parts:
        path = week_dir / f"{part}.xlsx"
        if not path.exists():
            out.append({"part": part, "status": "missing", "rows": 0, "mtime": None})
            continue
        mtime = datetime.fromtimestamp(path.stat().st_mtime).isoformat(timespec="seconds")
        rows = _count_rows_with_user_input(path)
        if rows == 0:
            out.append({"part": part, "status": "empty", "rows": 0, "mtime": mtime})
            continue
        out.append({"part": part, "status": "written", "rows": rows, "mtime": mtime})
    return out


def format_status_report(statuses: List[Dict[str, Any]], week: str, team_name: str) -> str:
    """Human-readable progress report.

    Args:
        statuses:  List of status dicts from compute_status().
        week:      Week identifier (e.g. "2026-W18").
        team_name: Team name (e.g. "기획팀").
    """
    lines = [f"=== {team_name} 작성 진척 — {week} ===", ""]
    for s in statuses:
        marker = _MARKERS.get(s["status"], "?")
        if s["status"] == "written":
            suffix = f"  ({s['rows']} rows, {s['mtime']})"
        elif s["status"] == "empty":
            suffix = "  (파일은 있지만 비어있음)"
        else:
            suffix = "  미작성"
        lines.append(f"  {marker} {s['part']}{suffix}")
    return "\n".join(lines) + "\n"
