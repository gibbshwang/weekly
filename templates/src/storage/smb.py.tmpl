"""SMBStorage — UNC-path backend.

Phase 1 implements SMB as a thin wrapper over OS-mounted UNC paths.
No `pysmb` dependency (corporate deployments handle auth via OS):
- Windows: `\\\\server\\share\\...` is natively traversable.
- Unix: admin pre-mounts via `mount.cifs` to a local path; the config
  uses that local path with `storage.type: smb`.

The implementation looks ~95% identical to LocalStorage. The duplication
is deliberate — Phase 2 may extract a shared base class when the API
shape is stable. Refactoring now would couple two otherwise independent
storage backends.
"""
import warnings
from pathlib import Path
from typing import Iterable, Union

from .base import Storage


class SMBStorage(Storage):
    def __init__(self, unc: Union[str, Path]) -> None:
        self.root = Path(unc)
        unc_str = str(unc)
        if not (unc_str.startswith("\\\\") or unc_str.startswith("/")):
            warnings.warn(
                f"SMBStorage root {unc_str!r} doesn't look like a UNC or absolute path. "
                f"Falling back to local-style access — usable for dogfood only.",
                stacklevel=2,
            )
        self.root.mkdir(parents=True, exist_ok=True)

    def _abs(self, relpath: Path) -> Path:
        return self.root / Path(relpath)

    def read_text(self, relpath: Path) -> str:
        return self._abs(relpath).read_text(encoding="utf-8")

    def read_bytes(self, relpath: Path) -> bytes:
        return self._abs(relpath).read_bytes()

    def write_text(self, relpath: Path, content: str) -> None:
        p = self._abs(relpath)
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(content, encoding="utf-8")

    def write_bytes(self, relpath: Path, content: bytes) -> None:
        p = self._abs(relpath)
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_bytes(content)

    def exists(self, relpath: Path) -> bool:
        return self._abs(relpath).exists()

    def list_dir(self, relpath: Path) -> Iterable[Path]:
        d = self._abs(relpath)
        if not d.is_dir():
            return []
        return [Path(p.name) for p in sorted(d.iterdir())]

    def mtime(self, relpath: Path) -> float:
        return self._abs(relpath).stat().st_mtime
