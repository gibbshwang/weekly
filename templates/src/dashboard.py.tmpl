"""Dashboard renderer — Jinja2 template + minimal placeholder CSS.

Phase 2 task-centric dashboard. Autoescape ON + custom nl2br filter
inherited from FIX-01: every Jinja substitution is HTML-escaped by
default, and the dedicated nl2br filter escapes its input first before
inserting trusted <br> markup so attacker-controlled content (LLM
prompt-injection in summary text, etc.) cannot synthesize new tags.
"""
from datetime import datetime
from pathlib import Path
from typing import Any, Dict

from jinja2 import Environment, FileSystemLoader, select_autoescape
from markupsafe import Markup, escape


def _nl2br_safe(value: Any) -> Markup:
    """Escape value, then convert real \\n to <br>."""
    return Markup(str(escape(value)).replace("\n", "<br>"))


def _build_env(template_dir: Path) -> Environment:
    env = Environment(
        loader=FileSystemLoader(str(template_dir)),
        autoescape=select_autoescape(["html", "j2", "html.j2"], default=True),
    )
    env.filters["nl2br"] = _nl2br_safe
    return env


def render_dashboard(
    result: Dict[str, Any],
    team_name: str,
    week: str,
    template_path: Path,
    weekly_version: str = "0.2.0",
) -> str:
    """Render the dashboard HTML from a Phase 2 compile result dict.

    Expected top-level keys: 팀_종합_요약, 지난주.{요약, 항목}, 이번주.{요약, 항목},
    그룹별_요약, 그룹장_확인필요, 미작성_파트, 주의사항.
    """
    template_path = Path(template_path)
    env = _build_env(template_path.parent)
    tmpl = env.get_template(template_path.name)
    return tmpl.render(
        result=result,
        team_name=team_name,
        week=week,
        generated_at=datetime.now().isoformat(timespec="seconds"),
        weekly_version=weekly_version,
    )
