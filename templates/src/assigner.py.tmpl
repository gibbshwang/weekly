"""Distribution engine — Phase 2 xlsx-based assign with deterministic 업무ID.

Reads new/modified rows from `_지시사항.xlsx`, picks the target part for
each (column match → LLM fallback), allocates a `W{week}-NNN` task ID,
and appends the row to that part workbook's 이번주 sheet.

Sidecar JSON state at `<team>/<week>/_assignments_state.json` tracks
processed row hashes so repeated cron ticks only handle new/modified rows.

NOTE: _strip_code_fence logic is intentionally duplicated from compiler.py.tmpl
(7 lines, zero external state). DRY's cost-benefit fails for this small,
clearly bounded helper — extracting a shared module would couple two otherwise
independent templates. Defer consolidation until a third consumer appears.
"""
import hashlib
import json
import re
from pathlib import Path
from typing import Any, Dict, List, Tuple

from jinja2 import Template

try:
    from openpyxl import load_workbook
    from weekly_runtime.xlsx_template import PART_SHEET_HEADERS, safe_excel_text
except ImportError:  # pragma: no cover — exercised by harness tests
    from openpyxl import load_workbook
    from scripts.xlsx_template import PART_SHEET_HEADERS, safe_excel_text


_TASK_ID_RE = re.compile(r"^W(\d{1,2})-(\d{3})$")

# Fields that participate in the instruction's *identity*. 비고 is intentionally
# excluded — the operator may annotate a row freely after assignment without
# triggering a new task ID. Hard cutover from the legacy row_index/row_hash
# scheme: state files written by older versions will look like an empty state
# (no `instructions` key) and every row will be re-processed once.
_INSTRUCTION_KEY_FIELDS = ("일자", "지시내용", "담당파트", "마감", "우선순위")


def _instruction_key(row: Dict[str, Any]) -> str:
    """Position-independent fingerprint of an instruction.

    Hashes a normalized projection of the identity-bearing fields so:
    - Reordering / inserting rows in the directives xlsx does not flip identity
    - Editing 비고 (operator commentary) does not flip identity
    - Editing 지시내용 etc. *does* flip identity (treated as a new instruction)
    """
    canonical = json.dumps(
        {
            field: (row.get(field) or "").strip() if isinstance(row.get(field), str)
                   else (row.get(field) or "")
            for field in _INSTRUCTION_KEY_FIELDS
        },
        sort_keys=True,
        ensure_ascii=False,
    )
    return "sha256:" + hashlib.sha256(canonical.encode("utf-8")).hexdigest()


def _strip_code_fence(text: str) -> str:
    text = text.strip()
    if text.startswith("```"):
        text = text.split("```", 2)[1]
        if text.lstrip().startswith("json"):
            text = text.lstrip()[4:]
        text = text.rsplit("```", 1)[0]
    return text.strip()


def diff_rows(rows: List[Dict[str, Any]], state_path: Path) -> List[int]:
    """Return indices of rows whose instruction_key has not been processed yet.

    Order-independent — sorting / inserting rows in the directives xlsx will
    not re-classify already-assigned content.
    """
    state_path = Path(state_path)
    if not state_path.exists():
        return list(range(len(rows)))
    state = json.loads(state_path.read_text(encoding="utf-8"))
    known = {entry["instruction_key"] for entry in state.get("instructions", [])}
    return [i for i, row in enumerate(rows) if _instruction_key(row) not in known]


def update_state(state_path: Path, rows: List[Dict[str, Any]],
                 entries: List[Tuple[int, str, str]]) -> None:
    """Persist processed-instruction state.

    `entries` is List[(row_index, assigned_part, method)] — the row_index
    is used only to look up the current row content for fingerprinting; it
    is not stored in the state file (that's the whole point of Todo 2).
    """
    state_path = Path(state_path)
    state_path.parent.mkdir(parents=True, exist_ok=True)
    payload = {
        "instructions": [
            {
                "instruction_key": _instruction_key(rows[idx]),
                "assigned_to": part,
                "method": method,
            }
            for idx, part, method in entries
        ]
    }
    state_path.write_text(json.dumps(payload, ensure_ascii=False, indent=2), encoding="utf-8")


def _carry_forward_state(state_path: Path) -> List[Dict[str, str]]:
    """Return all existing state entries unchanged.

    With the fingerprint scheme `diff_rows` already excludes any row whose
    key is in state, so every existing entry is safe to preserve verbatim.
    """
    state_path = Path(state_path)
    if not state_path.exists():
        return []
    existing = json.loads(state_path.read_text(encoding="utf-8")).get("instructions", [])
    return [
        {"instruction_key": e["instruction_key"],
         "assigned_to": e["assigned_to"],
         "method": e["method"]}
        for e in existing
    ]


def generate_task_id(week: str, seq: int) -> str:
    """`W18-003`-style task ID from an ISO week string and a sequence number.

    Accepts `2026-W18` or `W18`; uses just the week portion so IDs stay short
    enough to fit a column without wrapping.
    """
    week_short = week.rsplit("-", 1)[-1] if "-W" in week else f"W{int(week):02d}"
    if not week_short.startswith("W"):
        week_short = f"W{week_short}"
    return f"{week_short}-{seq:03d}"


def _seq_from_task_id(task_id: str, week_short: str):
    """Extract seq from `W18-NNN`, returning None if it isn't this week's prefix."""
    if not isinstance(task_id, str):
        return None
    m = _TASK_ID_RE.fullmatch(task_id.strip())
    if not m:
        return None
    if f"W{m.group(1).zfill(2)}" != week_short:
        return None
    return int(m.group(2))


def next_seq_for_week(part_xlsx_dir: Path, team, week: str) -> int:
    """Scan every part workbook and return max existing W{week}-NNN seq + 1.

    Looks at the 이번주 + 지난주 sheets (이월 rows in 지난주 keep their original
    week prefix, so they are correctly ignored by the prefix check).
    """
    week_short = week.rsplit("-", 1)[-1] if "-W" in week else week
    if not week_short.startswith("W"):
        week_short = f"W{int(week_short):02d}"
    part_xlsx_dir = Path(part_xlsx_dir)
    max_seq = 0
    for _, part in team.iter_parts():
        path = part_xlsx_dir / f"{part.name}.xlsx"
        if not path.exists():
            continue
        wb = load_workbook(path)
        for sheet_name in ("이번주", "지난주"):
            if sheet_name not in wb.sheetnames:
                continue
            for row in wb[sheet_name].iter_rows(min_row=2, values_only=True):
                if not row:
                    continue
                seq = _seq_from_task_id(row[0], week_short)
                if seq is not None and seq > max_seq:
                    max_seq = seq
    return max_seq + 1


def _find_part_in_team(team, part_name: str):
    """Return (group, part) for the named part, or (None, None)."""
    for g, p in team.iter_parts():
        if p.name == part_name:
            return g, p
    return None, None


def resolve_target_part(row: Dict[str, Any], team, llm, prompt_template_path: Path):
    """Group-aware part resolution.

    Returns (group, part, method) where method ∈ {"column", "ai_inferred"}.

    1. If 담당파트 is filled and matches a part in `team` → use it
       (grouping is derived from team membership; 담당그룹 is not asked of
       the instructor and the assigner reconstructs it from team layout).
    2. Else hand off to the LLM with the flat parts list. The LLM picks a
       part name; we look it up in the team to recover its group.
    3. If the LLM picks an invalid part, fall back to the first part of the
       first group.
    """
    candidate = (row.get("담당파트") or "").strip()
    g, p = _find_part_in_team(team, candidate)
    if p is not None:
        return g, p, "column"

    parts_with_role = [
        {"name": p.name, "role": p.role}
        for _, p in team.iter_parts()
    ]
    sys_prompt = Template(Path(prompt_template_path).read_text(encoding="utf-8")).render(
        dept_name=team.name, parts=parts_with_role,
    )
    user_payload = {k: row.get(k, "") for k in
                    ["일자", "지시내용", "우선순위", "마감", "비고"]}
    raw = llm.call(sys_prompt, json.dumps(user_payload, ensure_ascii=False))
    decision = json.loads(_strip_code_fence(raw))
    inferred = decision.get("추정_담당파트", "")
    g, p = _find_part_in_team(team, inferred)
    if p is None:
        g, p = next(iter(team.iter_parts()))   # fallback: first part of first group
    return g, p, "ai_inferred"


def append_to_part_xlsx(
    part_xlsx_path: Path,
    task_id: str,
    row: Dict[str, Any],
    source: str,
) -> None:
    """Append one row to the 이번주 sheet of an existing part workbook.

    `source` is written into the 출처 column — typically "지시사항" when called
    from the assigner, or "이월" when called from prepare's carry-forward
    (handled separately by prepare).
    """
    part_xlsx_path = Path(part_xlsx_path)
    wb = load_workbook(part_xlsx_path)
    ws = wb["이번주"]
    payload = {
        "업무ID": task_id,
        "출처": source,
        "업무_지시내용": row.get("지시내용", ""),
        "상태": "",
        "이번주_처리결과": "",
        "이슈_장애": "",
        "리스크_지원요청": "",
        "다음액션_차주계획": "",
        "마감": row.get("마감", ""),
        "우선순위": row.get("우선순위", ""),
        "비고": row.get("비고", ""),
    }
    # safe_excel_text neutralizes formula/CSV-injection leading chars in
    # free-text values copied from _지시사항.xlsx (지시내용, 비고, 마감).
    # System-generated columns (업무ID/출처/dropdowns) pass through unchanged.
    ws.append([safe_excel_text(payload.get(h, "")) for h in PART_SHEET_HEADERS])
    wb.save(part_xlsx_path)


def run_assign(
    rows: List[Dict[str, Any]],
    team,
    week: str,
    state_path: Path,
    part_xlsx_dir: Path,
    llm,
    prompt_template_path: Path,
) -> Dict[str, List[str]]:
    """Run a single assign tick.

    Returns `{part_name: [task_id, ...]}` of parts touched this tick.
    Idempotent on instruction_key: re-running with the same rows yields no
    new appends.

    Raises FileNotFoundError with an actionable message when the week's
    part workbooks do not exist yet (i.e. `wreport prepare <팀>` was
    skipped). The cron stack runs prepare on Monday morning before assign,
    but a fresh setup or manual first-run can hit this case.
    """
    new_idx = diff_rows(rows, state_path)
    if not new_idx:
        return {}

    # Prepare prerequisite: every part needs its xlsx workbook to exist.
    # Fail fast with a clear message rather than letting load_workbook raise
    # a generic FileNotFoundError mid-loop.
    week_dir_path = Path(part_xlsx_dir)
    missing = [
        p.name for _, p in team.iter_parts()
        if not (week_dir_path / f"{p.name}.xlsx").exists()
    ]
    if missing:
        raise FileNotFoundError(
            f"part workbooks missing for week {week!r}: {missing!r}. "
            f"Run `wreport prepare {team.name} --week={week}` first to create "
            f"the per-part xlsx files (and carry-forward any prior week's "
            f"incomplete tasks)."
        )

    seq = next_seq_for_week(part_xlsx_dir, team, week)
    affected: Dict[str, List[str]] = {}
    # All previously-processed instructions remain in state. diff_rows
    # already excluded their keys from new_idx, so nothing is reprocessed.
    carried = _carry_forward_state(state_path)
    new_entries: List[Tuple[int, str, str]] = []

    for idx in sorted(new_idx):
        row = rows[idx]
        group, part, method = resolve_target_part(
            row, team=team, llm=llm, prompt_template_path=prompt_template_path,
        )
        task_id = generate_task_id(week, seq)
        seq += 1
        append_to_part_xlsx(
            part_xlsx_path=Path(part_xlsx_dir) / f"{part.name}.xlsx",
            task_id=task_id, row=row, source="지시사항",
        )
        affected.setdefault(part.name, []).append(task_id)
        new_entries.append((idx, part.name, method))

    # Persist carried-forward + newly-assigned. We rebuild the state file in
    # one shot — the new payload is the union of both.
    state_path = Path(state_path)
    state_path.parent.mkdir(parents=True, exist_ok=True)
    payload = {
        "instructions": [
            *carried,
            *[
                {"instruction_key": _instruction_key(rows[idx]),
                 "assigned_to": part, "method": method}
                for idx, part, method in new_entries
            ],
        ]
    }
    state_path.write_text(json.dumps(payload, ensure_ascii=False, indent=2), encoding="utf-8")
    return affected
