"""Distribution engine — Phase 2 xlsx-based assign with deterministic 업무ID.

Reads new/modified rows from `_지시사항.xlsx`, picks the target part for
each (column match → LLM fallback), allocates a `W{week}-NNN` task ID,
and appends the row to that part workbook's 이번주 sheet.

Sidecar JSON state at `<team>/<week>/_assignments_state.json` tracks
processed row hashes so repeated cron ticks only handle new/modified rows.

NOTE: _strip_code_fence logic is intentionally duplicated from compiler.py.tmpl
(7 lines, zero external state). DRY's cost-benefit fails for this small,
clearly bounded helper — extracting a shared module would couple two otherwise
independent templates. Defer consolidation until a third consumer appears.
"""
import hashlib
import json
import os
import re
import time
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple

from jinja2 import Template


# Stale-lock threshold. If a previous assign crashed and left a lockfile,
# recover after this many seconds rather than deadlocking subsequent ticks.
# 600s = 10 min — comfortably longer than a normal assign (LLM call + SMTP)
# but short enough that an actual crash doesn't block a full hourly cycle.
_LOCK_STALE_SECONDS = 600


def _acquire_lock(lock_path: Path, stale_after: int = _LOCK_STALE_SECONDS) -> Optional[int]:
    """Atomically create a sidecar lockfile. Returns the open fd on success,
    None if another active process holds it.

    Stale locks (mtime older than `stale_after`) are removed and the acquire
    is retried. Cross-platform via os.open with O_CREAT|O_EXCL.
    """
    while True:
        try:
            return os.open(str(lock_path), os.O_CREAT | os.O_EXCL | os.O_WRONLY)
        except FileExistsError:
            try:
                age = time.time() - os.path.getmtime(str(lock_path))
            except FileNotFoundError:
                continue   # lock just released; loop and retry
            if age < stale_after:
                return None
            try:
                os.unlink(str(lock_path))
            except FileNotFoundError:
                pass   # someone else recovered it; loop and retry

try:
    from openpyxl import load_workbook
    from weekly_runtime.xlsx_template import PART_SHEET_HEADERS, safe_excel_text
except ImportError:  # pragma: no cover — exercised by harness tests
    from openpyxl import load_workbook
    from scripts.xlsx_template import PART_SHEET_HEADERS, safe_excel_text


_TASK_ID_RE = re.compile(r"^W(\d{1,2})-(\d{3})$")

# Identity-bearing fields. Editing one of these creates a *new* logical task
# (the instruction has substantively changed). Editing the other content
# fields below updates the existing task's mutable cells in place.
# 비고 is excluded from BOTH so operator commentary doesn't flip anything.
_INSTRUCTION_KEY_FIELDS = ("일자", "지시내용", "담당파트")
# Mutable fields — their values flow through to the part xlsx and are updated
# on edit, but they don't change the instruction's identity.
_CONTENT_FIELDS = _INSTRUCTION_KEY_FIELDS + ("마감", "우선순위", "비고")


def _normalized_field(value) -> str:
    if value is None:
        return ""
    if isinstance(value, str):
        return value.strip()
    return str(value)


def _instruction_key(row: Dict[str, Any]) -> str:
    """Position-independent identity of an instruction (immutable fields only).

    - Reordering / inserting rows in the directives xlsx does not flip identity.
    - Editing 마감 / 우선순위 / 비고 does NOT flip identity (those are mutable).
    - Editing 일자 / 지시내용 / 담당파트 *does* flip identity (treated as a
      new instruction; old task remains in the part xlsx).
    """
    canonical = json.dumps(
        {f: _normalized_field(row.get(f)) for f in _INSTRUCTION_KEY_FIELDS},
        sort_keys=True,
        ensure_ascii=False,
    )
    return "sha256:" + hashlib.sha256(canonical.encode("utf-8")).hexdigest()


def _content_hash(row: Dict[str, Any]) -> str:
    """Snapshot of all content-bearing fields (identity + mutable). When this
    changes for a known instruction_key, the part xlsx row needs an in-place
    update for the changed mutable cells (마감 / 우선순위 / 비고)."""
    canonical = json.dumps(
        {f: _normalized_field(row.get(f)) for f in _CONTENT_FIELDS},
        sort_keys=True,
        ensure_ascii=False,
    )
    return "sha256:" + hashlib.sha256(canonical.encode("utf-8")).hexdigest()


def _strip_code_fence(text: str) -> str:
    text = text.strip()
    if text.startswith("```"):
        text = text.split("```", 2)[1]
        if text.lstrip().startswith("json"):
            text = text.lstrip()[4:]
        text = text.rsplit("```", 1)[0]
    return text.strip()


def diff_rows(rows: List[Dict[str, Any]], state_path: Path) -> Tuple[List[int], List[int]]:
    """Classify each row against last-known state.

    Returns (new_indices, updated_indices):
      new_indices    — instruction_key never seen before (assign + append)
      updated_indices — known instruction_key but content_hash changed
                        (마감/우선순위/비고 edited; update part xlsx in place)

    Order-independent. Identity-stable rows whose mutable fields didn't
    change are excluded from both lists (no work needed).
    """
    state_path = Path(state_path)
    if not state_path.exists():
        return list(range(len(rows))), []
    state = json.loads(state_path.read_text(encoding="utf-8"))
    known: Dict[str, Dict[str, str]] = {
        entry["instruction_key"]: entry
        for entry in state.get("instructions", [])
    }
    new_idx, updated_idx = [], []
    for i, row in enumerate(rows):
        ikey = _instruction_key(row)
        if ikey not in known:
            new_idx.append(i)
        elif known[ikey].get("content_hash") != _content_hash(row):
            updated_idx.append(i)
    return new_idx, updated_idx


def _read_state(state_path: Path) -> List[Dict[str, str]]:
    """Return the persisted instruction entries (or empty list if none yet)."""
    state_path = Path(state_path)
    if not state_path.exists():
        return []
    return json.loads(state_path.read_text(encoding="utf-8")).get("instructions", [])


def _state_entry_for_key(state_path: Path, instruction_key: str) -> Optional[Dict[str, str]]:
    for e in _read_state(state_path):
        if e.get("instruction_key") == instruction_key:
            return e
    return None


def update_state(state_path: Path, rows: List[Dict[str, Any]],
                 entries: List[Tuple[int, str, str]]) -> None:
    """Persist processed-instruction state with task_id + content_hash.

    `entries` is List[(row_index, assigned_part, method)]. Pre-existing entries
    in `entries` whose row index is None can be passed through with their
    fields preserved (used by the in-place-update path which doesn't have a
    row_index — it has the existing task_id from state).
    """
    state_path = Path(state_path)
    state_path.parent.mkdir(parents=True, exist_ok=True)
    payload = {
        "instructions": [
            {
                "instruction_key": _instruction_key(rows[idx]),
                "content_hash": _content_hash(rows[idx]),
                # task_id is filled in by run_assign — bare update_state
                # callers (legacy tests) don't have it; tolerate absence.
                "task_id": "",
                "assigned_to": part,
                "method": method,
            }
            for idx, part, method in entries
        ]
    }
    state_path.write_text(json.dumps(payload, ensure_ascii=False, indent=2), encoding="utf-8")


def _carry_forward_state(state_path: Path) -> List[Dict[str, str]]:
    """Return all existing state entries unchanged.

    With the identity_key + content_hash scheme, diff_rows already classifies
    every row as new / updated / unchanged and returns indices for the first
    two. Existing state entries belong to "unchanged or updated" rows; updated
    rows will be re-emitted with refreshed content_hash by run_assign, so
    starting from the existing entries is the right baseline.
    """
    return [
        {"instruction_key": e["instruction_key"],
         "content_hash": e.get("content_hash", ""),
         "task_id": e.get("task_id", ""),
         "assigned_to": e.get("assigned_to", ""),
         "method": e.get("method", "")}
        for e in _read_state(state_path)
    ]


def generate_task_id(week: str, seq: int) -> str:
    """`W18-003`-style task ID from an ISO week string and a sequence number.

    Accepts `2026-W18` or `W18`; uses just the week portion so IDs stay short
    enough to fit a column without wrapping.
    """
    week_short = week.rsplit("-", 1)[-1] if "-W" in week else f"W{int(week):02d}"
    if not week_short.startswith("W"):
        week_short = f"W{week_short}"
    return f"{week_short}-{seq:03d}"


def _seq_from_task_id(task_id: str, week_short: str):
    """Extract seq from `W18-NNN`, returning None if it isn't this week's prefix."""
    if not isinstance(task_id, str):
        return None
    m = _TASK_ID_RE.fullmatch(task_id.strip())
    if not m:
        return None
    if f"W{m.group(1).zfill(2)}" != week_short:
        return None
    return int(m.group(2))


def next_seq_for_week(part_xlsx_dir: Path, team, week: str) -> int:
    """Scan every part workbook and return max existing W{week}-NNN seq + 1.

    Looks at the 이번주 + 지난주 sheets (이월 rows in 지난주 keep their original
    week prefix, so they are correctly ignored by the prefix check).
    """
    week_short = week.rsplit("-", 1)[-1] if "-W" in week else week
    if not week_short.startswith("W"):
        week_short = f"W{int(week_short):02d}"
    part_xlsx_dir = Path(part_xlsx_dir)
    max_seq = 0
    for _, part in team.iter_parts():
        path = part_xlsx_dir / f"{part.name}.xlsx"
        if not path.exists():
            continue
        wb = load_workbook(path)
        for sheet_name in ("이번주", "지난주"):
            if sheet_name not in wb.sheetnames:
                continue
            for row in wb[sheet_name].iter_rows(min_row=2, values_only=True):
                if not row:
                    continue
                seq = _seq_from_task_id(row[0], week_short)
                if seq is not None and seq > max_seq:
                    max_seq = seq
    return max_seq + 1


def _find_part_in_team(team, part_name: str):
    """Return (group, part) for the named part, or (None, None)."""
    for g, p in team.iter_parts():
        if p.name == part_name:
            return g, p
    return None, None


def resolve_target_part(row: Dict[str, Any], team, llm, prompt_template_path: Path):
    """Group-aware part resolution.

    Returns (group, part, method) where method ∈ {"column", "ai_inferred"}.

    1. If 담당파트 is filled and matches a part in `team` → use it
       (grouping is derived from team membership; 담당그룹 is not asked of
       the instructor and the assigner reconstructs it from team layout).
    2. Else hand off to the LLM with the flat parts list. The LLM picks a
       part name; we look it up in the team to recover its group.
    3. If the LLM picks an invalid part, fall back to the first part of the
       first group.
    """
    candidate = (row.get("담당파트") or "").strip()
    g, p = _find_part_in_team(team, candidate)
    if p is not None:
        return g, p, "column"

    parts_with_role = [
        {"name": p.name, "role": p.role}
        for _, p in team.iter_parts()
    ]
    sys_prompt = Template(Path(prompt_template_path).read_text(encoding="utf-8")).render(
        dept_name=team.name, parts=parts_with_role,
    )
    user_payload = {k: row.get(k, "") for k in
                    ["일자", "지시내용", "우선순위", "마감", "비고"]}
    raw = llm.call(sys_prompt, json.dumps(user_payload, ensure_ascii=False))
    decision = json.loads(_strip_code_fence(raw))
    inferred = decision.get("추정_담당파트", "")
    g, p = _find_part_in_team(team, inferred)
    if p is None:
        g, p = next(iter(team.iter_parts()))   # fallback: first part of first group
    return g, p, "ai_inferred"


_MUTABLE_PART_FIELDS = ("마감", "우선순위", "비고")


def update_part_xlsx_row(part_xlsx_path: Path, task_id: str, row: Dict[str, Any]) -> bool:
    """Update mutable cells (마감 / 우선순위 / 비고) on the existing row whose
    업무ID matches `task_id`. Lead-input columns (상태 / 처리결과 / etc.) are
    NOT touched — those belong to the part lead.

    Returns True if a row was found and updated, False if no row matched
    (caller may fall back to append). Searches 이번주 first, then 지난주.
    """
    part_xlsx_path = Path(part_xlsx_path)
    wb = load_workbook(part_xlsx_path)
    for sheet_name in ("이번주", "지난주"):
        if sheet_name not in wb.sheetnames:
            continue
        ws = wb[sheet_name]
        for r in ws.iter_rows(min_row=2):
            if r and r[0].value == task_id:
                for field in _MUTABLE_PART_FIELDS:
                    col_idx = PART_SHEET_HEADERS.index(field)
                    r[col_idx].value = safe_excel_text(row.get(field, ""))
                wb.save(part_xlsx_path)
                return True
    return False


def append_to_part_xlsx(
    part_xlsx_path: Path,
    task_id: str,
    row: Dict[str, Any],
    source: str,
) -> None:
    """Append one row to the 이번주 sheet of an existing part workbook.

    `source` is written into the 출처 column — typically "지시사항" when called
    from the assigner, or "이월" when called from prepare's carry-forward
    (handled separately by prepare).
    """
    part_xlsx_path = Path(part_xlsx_path)
    wb = load_workbook(part_xlsx_path)
    ws = wb["이번주"]
    payload = {
        "업무ID": task_id,
        "출처": source,
        "업무_지시내용": row.get("지시내용", ""),
        "상태": "",
        "이번주_처리결과": "",
        "이슈_장애": "",
        "리스크_지원요청": "",
        "다음액션_차주계획": "",
        "마감": row.get("마감", ""),
        "우선순위": row.get("우선순위", ""),
        "비고": row.get("비고", ""),
    }
    # safe_excel_text neutralizes formula/CSV-injection leading chars in
    # free-text values copied from _지시사항.xlsx (지시내용, 비고, 마감).
    # System-generated columns (업무ID/출처/dropdowns) pass through unchanged.
    ws.append([safe_excel_text(payload.get(h, "")) for h in PART_SHEET_HEADERS])
    wb.save(part_xlsx_path)


def run_assign(
    rows: List[Dict[str, Any]],
    team,
    week: str,
    state_path: Path,
    part_xlsx_dir: Path,
    llm,
    prompt_template_path: Path,
) -> Dict[str, List[str]]:
    """Run a single assign tick.

    Returns `{part_name: [task_id, ...]}` of parts touched this tick.
    Idempotent on instruction_key: re-running with the same rows yields no
    new appends.

    Raises FileNotFoundError with an actionable message when the week's
    part workbooks do not exist yet (i.e. `wreport prepare <팀>` was
    skipped). The cron stack runs prepare on Monday morning before assign,
    but a fresh setup or manual first-run can hit this case.
    """
    new_idx, updated_idx = diff_rows(rows, state_path)
    if not new_idx and not updated_idx:
        return {}

    # Prepare prerequisite: every part needs its xlsx workbook to exist.
    # Fail fast with a clear message rather than letting load_workbook raise
    # a generic FileNotFoundError mid-loop.
    week_dir_path = Path(part_xlsx_dir)
    missing = [
        p.name for _, p in team.iter_parts()
        if not (week_dir_path / f"{p.name}.xlsx").exists()
    ]
    if missing:
        raise FileNotFoundError(
            f"part workbooks missing for week {week!r}: {missing!r}. "
            f"Run `wreport prepare {team.name} --week={week}` first to create "
            f"the per-part xlsx files (and carry-forward any prior week's "
            f"incomplete tasks)."
        )

    # Sidecar advisory lock so two concurrent assign ticks (overlapping
    # cron + LLM/SMTP delay) cannot both append to the same part xlsx.
    # Stale locks recover after _LOCK_STALE_SECONDS so a crashed run
    # doesn't permanently block the schedule.
    state_path = Path(state_path)
    state_path.parent.mkdir(parents=True, exist_ok=True)
    lock_path = Path(str(state_path) + ".lock")
    fd = _acquire_lock(lock_path)
    if fd is None:
        # Another active assign run holds the lock; skip silently —
        # the holding process will commit, and the next cron tick will
        # pick up any further new rows.
        return {}

    try:
        try:
            os.write(fd, str(os.getpid()).encode())
        finally:
            os.close(fd)

        seq = next_seq_for_week(part_xlsx_dir, team, week)
        affected: Dict[str, List[str]] = {}
        # Carry the existing state forward; we'll mutate updated entries
        # in place and append new entries below before rewriting state.
        carried = _carry_forward_state(state_path)
        # Build a key→entry map so the update path can find + mutate the
        # right state row by instruction_key.
        carried_by_key = {e["instruction_key"]: e for e in carried}

        # NEW rows: assign + append
        for idx in sorted(new_idx):
            row = rows[idx]
            group, part, method = resolve_target_part(
                row, team=team, llm=llm, prompt_template_path=prompt_template_path,
            )
            task_id = generate_task_id(week, seq)
            seq += 1
            append_to_part_xlsx(
                part_xlsx_path=Path(part_xlsx_dir) / f"{part.name}.xlsx",
                task_id=task_id, row=row, source="지시사항",
            )
            affected.setdefault(part.name, []).append(task_id)
            entry = {
                "instruction_key": _instruction_key(row),
                "content_hash": _content_hash(row),
                "task_id": task_id,
                "assigned_to": part.name,
                "method": method,
            }
            carried_by_key[entry["instruction_key"]] = entry

        # UPDATED rows: mutate the existing part xlsx row in place. Lead-input
        # cells (상태 / 처리결과 / etc.) are preserved; only mutable cells
        # (마감 / 우선순위 / 비고) are refreshed.
        for idx in sorted(updated_idx):
            row = rows[idx]
            ikey = _instruction_key(row)
            existing = carried_by_key.get(ikey)
            if not existing or not existing.get("task_id"):
                # State is missing task_id (legacy entry pre-PR#21 or hand-
                # edited state). Treat as new to keep things working.
                group, part, method = resolve_target_part(
                    row, team=team, llm=llm, prompt_template_path=prompt_template_path,
                )
                task_id = generate_task_id(week, seq)
                seq += 1
                append_to_part_xlsx(
                    part_xlsx_path=Path(part_xlsx_dir) / f"{part.name}.xlsx",
                    task_id=task_id, row=row, source="지시사항",
                )
                affected.setdefault(part.name, []).append(task_id)
                carried_by_key[ikey] = {
                    "instruction_key": ikey,
                    "content_hash": _content_hash(row),
                    "task_id": task_id,
                    "assigned_to": part.name,
                    "method": method,
                }
                continue
            task_id = existing["task_id"]
            assigned_part_name = existing["assigned_to"]
            updated = update_part_xlsx_row(
                part_xlsx_path=Path(part_xlsx_dir) / f"{assigned_part_name}.xlsx",
                task_id=task_id, row=row,
            )
            # Refresh content_hash regardless of whether the part xlsx had
            # the row (e.g. it may have moved to next week's folder); the
            # update either succeeded or was a no-op.
            existing["content_hash"] = _content_hash(row)
            if updated:
                affected.setdefault(assigned_part_name, []).append(task_id)

        payload = {"instructions": list(carried_by_key.values())}
        state_path.write_text(
            json.dumps(payload, ensure_ascii=False, indent=2), encoding="utf-8"
        )
        return affected
    finally:
        try:
            os.unlink(str(lock_path))
        except FileNotFoundError:
            pass
