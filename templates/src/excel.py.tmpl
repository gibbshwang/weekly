"""Excel reader for `_지시사항.xlsx` (Phase 2 — 7-column header).

Reads all data rows (skipping header) into list of dicts keyed by column name.
Computes stable hash per row for change detection (sidecar JSON state).
"""
import hashlib
import json
from pathlib import Path
from typing import Any, Dict, List

from openpyxl import load_workbook

EXPECTED_HEADERS = [
    "일자", "지시내용", "담당그룹", "담당파트", "우선순위", "마감", "비고",
]


def read_instructions(xlsx_path: Path) -> List[Dict[str, Any]]:
    """Read the active sheet of `_지시사항.xlsx`, return list of dicts.

    The active sheet must have headers matching EXPECTED_HEADERS in row 1
    (강제 — stale 6-col files are rejected at load time so a downstream
    consumer can't silently see fewer fields than it expected).

    The 담당그룹 column is informational; the assigner uses 담당파트 for
    the deterministic match and falls back to the LLM if blank.

    Empty cells become "".
    """
    wb = load_workbook(xlsx_path, read_only=True, data_only=True)
    ws = wb.active
    header_row = next(ws.iter_rows(min_row=1, max_row=1))
    header = [c.value for c in header_row]
    if [h for h in header if h] != EXPECTED_HEADERS:
        raise ValueError(
            f"Unexpected headers: {header} (expected {EXPECTED_HEADERS})"
        )
    rows: List[Dict[str, Any]] = []
    for row in ws.iter_rows(min_row=2, values_only=True):
        if all(v is None or v == "" for v in row):
            continue
        record = {
            header[i]: ("" if v is None else str(v))
            for i, v in enumerate(row[: len(header)])
        }
        rows.append(record)
    wb.close()
    return rows


def row_hash(row: Dict[str, Any]) -> str:
    """Stable SHA256 hash of a row dict for change detection."""
    canonical = json.dumps(row, sort_keys=True, ensure_ascii=False)
    return "sha256:" + hashlib.sha256(canonical.encode("utf-8")).hexdigest()
