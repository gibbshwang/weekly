"""OS keyring wrapper — store SMTP password per department.

Service name convention: `weekly-<dept>` (full department name).
Username: `smtp_password` only.

NOTE: No AI API key storage. Per security policy (2026-04-25), AI calls
go through sanctioned Codex CLI / Gemini CLI subprocess which use their
own auth (Enterprise managed credentials / OAuth). The keyring is therefore
limited to SMTP credentials.
"""
import keyring


def set_secret(service: str, username: str, value: str) -> None:
    """Store a secret in the OS keyring."""
    keyring.set_password(service, username, value)


def get_secret(service: str, username: str) -> str:
    """Retrieve a secret. Raises KeyError if missing."""
    val = keyring.get_password(service, username)
    if val is None:
        raise KeyError(f"Secret {service}/{username} not found in keyring")
    return val


def delete_secret(service: str, username: str) -> None:
    """Remove a secret. Idempotent — no error if already missing."""
    try:
        keyring.delete_password(service, username)
    except keyring.errors.PasswordDeleteError:
        pass
